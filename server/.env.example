# Server Environment Variables for Deployment (Render)
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://gambit.vercel.app,http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=escapify123
POSTGRES_DB=gambit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternatively, pass full DATABASE_URL for managed PostgreSQL (e.g. Supabase, Render Postgres, Neon):
# DATABASE_URL=postgresql://user:pass@ep-host.region.aws.neon.tech/gambit?sslmode=require

# Session Secret Key
SESSION_SECRET=gambit_express_session_secret_key_2026

# Optional Redis Cache / PubSub
# REDIS_URL=redis://localhost:6379
